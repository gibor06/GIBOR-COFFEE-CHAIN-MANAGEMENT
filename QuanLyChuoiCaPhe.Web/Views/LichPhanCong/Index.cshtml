@model IEnumerable<LichPhanCong>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Quản lý Lịch phân công";
}

@Html.AntiForgeryToken()

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-calendar-check"></i> Quản lý Lịch phân công</h2>
        <a asp-action="Create" class="btn btn-coffee">
            <i class="bi bi-plus-circle"></i> Thêm lịch phân công
        </a>
    </div>

    <!-- Form lọc -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <input type="date" name="ngay" class="form-control" value="@(ViewBag.Ngay != null ? ((DateTime)ViewBag.Ngay).ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-md-3">
                    <select name="maNV" class="form-select">
                        <option value="">-- Tất cả nhân viên --</option>
                        @if (ViewBag.NhanViens != null)
                        {
                            @foreach (SelectListItem nv in ViewBag.NhanViens)
                            {
                                <option value="@nv.Value" selected="@(ViewBag.MaNV == nv.Value)">@nv.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="trangThai" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Đã phân công" selected="@(ViewBag.TrangThai == "Đã phân công")">Đã phân công</option>
                        <option value="Hủy ca" selected="@(ViewBag.TrangThai == "Hủy ca")">Hủy ca</option>
                        <option value="Nghỉ phép" selected="@(ViewBag.TrangThai == "Nghỉ phép")">Nghỉ phép</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-clockwise"></i> Làm mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Mã lịch</th>
                            <th>Nhân viên</th>
                            <th>Ca làm</th>
                            <th>Ngày làm việc</th>
                            <th>Giờ ca</th>
                            <th>Trạng thái</th>
                            <th>Ghi chú</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.MaLich</strong></td>
                                <td>@item.ThongTinNhanVien?.HoTenNV</td>
                                <td>@item.CaLamViec?.TenCa</td>
                                <td>@item.NgayLamViec.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.CaLamViec != null)
                                    {
                                        @($"{item.CaLamViec.GioBatDau:hh\\:mm} - {item.CaLamViec.GioKetThuc:hh\\:mm}")
                                    }
                                </td>
                                <td>
                                    @switch (item.TrangThai)
                                    {
                                        case "Đã phân công":
                                            <span class="badge bg-success">Đã phân công</span>
                                            break;
                                        case "Hủy ca":
                                            <span class="badge bg-danger">Hủy ca</span>
                                            break;
                                        case "Nghỉ phép":
                                            <span class="badge bg-secondary">Nghỉ phép</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@item.TrangThai</span>
                                            break;
                                    }
                                </td>
                                <td>@item.GhiChu</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.MaLich" class="btn btn-sm btn-primary" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="xoaLich('@item.MaLich')" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p>Không có dữ liệu lịch phân công.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function xoaLich(id) {
            if (confirm('Bạn có chắc chắn muốn xóa lịch phân công này?')) {
                fetch('/LichPhanCong/Delete?id=' + encodeURIComponent(id), {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(data.message, 'error');
                    }
                });
            }
        }
    </script>
}
