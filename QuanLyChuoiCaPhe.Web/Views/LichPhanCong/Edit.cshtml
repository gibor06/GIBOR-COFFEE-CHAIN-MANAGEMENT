@model LichPhanCong
@{
    ViewData["Title"] = "Sửa Lịch phân công";
}

<div class="container-fluid p-4">
    <h2><i class="bi bi-pencil"></i> Sửa Lịch phân công: @Model.MaLich</h2>

    <div class="card mt-3">
        <div class="card-body">
            <!-- Thông tin chỉ đọc -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Nhân viên</label>
                    <p>@Model.ThongTinNhanVien?.HoTenNV (@Model.MaNV)</p>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Ca làm</label>
                    <p>@Model.CaLamViec?.TenCa (@Model.MaCa)</p>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Ngày làm việc</label>
                    <p>@Model.NgayLamViec.ToString("dd/MM/yyyy")</p>
                </div>
            </div>

            <hr />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <strong>Có lỗi xảy ra:</strong>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaLich" />
                <input type="hidden" asp-for="MaNV" />
                <input type="hidden" asp-for="MaCa" />
                <input type="hidden" asp-for="NgayLamViec" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="TrangThai" class="form-label">Trạng thái <span class="text-danger">*</span></label>
                        <select asp-for="TrangThai" class="form-select" required>
                            <option value="Đã phân công">Đã phân công</option>
                            <option value="Hủy ca">Hủy ca</option>
                            <option value="Nghỉ phép">Nghỉ phép</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                        <input asp-for="GhiChu" class="form-control" maxlength="200" />
                        <span asp-validation-for="GhiChu" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-coffee">
                        <i class="bi bi-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
