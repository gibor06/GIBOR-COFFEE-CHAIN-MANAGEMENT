@model IEnumerable<DonHang>
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    var currentRole = Context.Session.GetString("VaiTro");
    var canCreateOrder = string.Equals(currentRole, "ADMIN", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentRole, "NHAN_VIEN", StringComparison.OrdinalIgnoreCase);
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-receipt"></i> Quản lý Đơn hàng</h2>
        @if (!User.IsInRole("KE_TOAN"))
        {
            <a asp-action="Create" class="btn btn-coffee">
                <i class="bi bi-plus-circle"></i> Tạo đơn hàng
            </a>
        }
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-3" id="orderFilterForm">
                <div class="col-md-2">
                    <label class="form-label" style="font-size: 0.85rem; margin-bottom: 2px;">Mã đơn hàng</label>
                    <input type="text" name="search" class="form-control" placeholder="Mã đơn hàng..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" style="font-size: 0.85rem; margin-bottom: 2px;">Trạng thái</label>
                    <select name="trangThai" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <option value="Khởi tạo" selected="@(ViewBag.TrangThai == "Khởi tạo")">Khởi tạo</option>
                        <option value="Hoàn tất" selected="@(ViewBag.TrangThai == "Hoàn tất")">Hoàn tất</option>
                        <option value="Hủy" selected="@(ViewBag.TrangThai == "Hủy")">Hủy</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" style="font-size: 0.85rem; margin-bottom: 2px;">Từ ngày</label>
                    <input type="date" name="tuNgay" id="tuNgay" class="form-control" placeholder="dd/mm/yyyy" value="@ViewBag.TuNgay" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" style="font-size: 0.85rem; margin-bottom: 2px;">Đến ngày</label>
                    <input type="date" name="denNgay" id="denNgay" class="form-control" placeholder="dd/mm/yyyy" value="@ViewBag.DenNgay" />
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                    <a asp-action="Index" class="btn btn-secondary" title="Làm mới">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                    @if (string.Equals(currentRole, "KE_TOAN", StringComparison.OrdinalIgnoreCase) || string.Equals(currentRole, "ADMIN", StringComparison.OrdinalIgnoreCase))
                    {
                        <button type="button" onclick="exportTableToExcel('donHangTable', 'danh-sach-don-hang')" class="btn btn-success" title="Xuất file Excel">
                            <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="donHangTable">
                    <thead>
                        <tr>
                            <th>Mã ĐH</th>
                            <th>Chi nhánh</th>
                            <th>Nhân viên</th>
                            <th>Khách hàng</th>
                            <th>Tổng tiền</th>
                            <th>Giảm giá</th>
                            <th>Thành tiền</th>
                            <th>PTTT</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.MaDH</strong></td>
                                <td>@item.ChiNhanh.TenChiNhanh</td>
                                <td>@item.ThongTinNhanVien.HoTenNV</td>
                                <td>@(item.KhachHang?.TenKH ?? "Vãng lai")</td>
                                <td>@item.TongTien.ToString("N0") đ</td>
                                <td>@item.GiamGia.ToString("N0") đ</td>
                                <td class="text-success"><strong>@((item.TongTien - item.GiamGia).ToString("N0")) đ</strong></td>
                                <td>@item.PhuongThucThanhToan</td>
                                <td>@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.TrangThai == "Khởi tạo")
                                    {
                                        <span class="badge bg-secondary">@item.TrangThai</span>
                                    }
                                    else if (item.TrangThai == "Hoàn tất")
                                    {
                                        <span class="badge bg-success">@item.TrangThai</span>
                                    }
                                    else if (item.TrangThai == "Hủy")
                                    {
                                        <span class="badge bg-danger">@item.TrangThai</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">@item.TrangThai</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.MaDH" class="btn btn-sm btn-info" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (!User.IsInRole("KE_TOAN") && item.TrangThai != "Hoàn tất" && item.TrangThai != "Hủy")
                                        {
                                            <div class="btn-group" role="group">
                                                <button type="button" class="btn btn-sm btn-secondary dropdown-toggle" data-bs-toggle="dropdown" title="Cập nhật trạng thái">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="capNhatTrangThai('@item.MaDH', 'Hoàn tất')">Hoàn tất</a></li>
                                                </ul>
                                            </div>
 
                                            <button type="button" class="btn btn-sm btn-danger" onclick="huyDonHang('@item.MaDH')" title="Hủy đơn">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center m-0">
                    <i class="bi bi-info-circle"></i> Không tìm thấy đơn hàng phù hợp.
                </div>
            }
        </div>
    </div>
</div>

<script>
function capNhatTrangThai(maDH, trangThai) {
    if (!confirm(`Bạn có chắc muốn cập nhật trạng thái đơn hàng ${maDH} thành '${trangThai}'?`)) {
        return;
    }

    fetch('@Url.Action("CapNhatTrangThai", "DonHang")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: `id=${maDH}&trangThai=${encodeURIComponent(trangThai)}`
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            location.reload();
        } else {
            alert('Lỗi: ' + data.message);
        }
    })
    .catch(error => {
        alert('Lỗi: ' + error);
    });
}

function huyDonHang(maDH) {
    if (!confirm(`Bạn có chắc muốn HỦY đơn hàng ${maDH}?\n\nLưu ý: Đơn hàng đã hủy không thể khôi phục!`)) {
        return;
    }

    fetch('@Url.Action("HuyDonHang", "DonHang")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: `id=${maDH}`
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            location.reload();
        } else {
            alert('Lỗi: ' + data.message);
        }
    })
    .catch(error => {
        alert('Lỗi: ' + error);
    });
}
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterForm = document.getElementById('orderFilterForm');
    if (filterForm) {
        filterForm.addEventListener('submit', function(e) {
            const tuNgayVal = document.getElementById('tuNgay').value;
            const denNgayVal = document.getElementById('denNgay').value;
            if (tuNgayVal && denNgayVal && new Date(tuNgayVal) > new Date(denNgayVal)) {
                e.preventDefault();
                alert('Lỗi: Khoảng thời gian không hợp lệ: "Từ ngày" phải nhỏ hơn hoặc bằng "Đến ngày"!');
            }
        });
    }
});
</script>
