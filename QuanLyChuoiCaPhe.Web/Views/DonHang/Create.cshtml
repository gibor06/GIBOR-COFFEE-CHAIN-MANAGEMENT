@model DonHangCreateViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Tạo Đơn hàng";
    var bienThesForView = ViewBag.BienThes as List<BienTheSanPham> ?? new List<BienTheSanPham>();
    var sanPhamGroups = bienThesForView
        .GroupBy(bt => bt.SanPham)
        .ToList();
    var priceByBienThe = ViewBag.BienThePrices as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
    var khachHangInfosJson = JsonSerializer.Serialize(ViewBag.KhachHangInfos ?? Array.Empty<object>());
}

<style>
    .product-card {
        cursor: pointer;
        transition: all 0.3s ease;
        border: 2px solid transparent;
        height: 100%;
    }
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        border-color: #8B4513;
    }
    .product-card.selected {
        border-color: #8B4513;
        background-color: #fff8f0;
    }
    .product-image {
        width: 100%;
        height: 150px;
        object-fit: cover;
        border-radius: 8px 8px 0 0;
    }
    .product-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: #333;
        min-height: 40px;
    }
    .product-price {
        color: #8B4513;
        font-weight: 700;
        font-size: 1.1rem;
    }
    .size-badge {
        cursor: pointer;
        transition: all 0.2s;
    }
    .size-badge:hover {
        transform: scale(1.1);
    }
    .size-badge.active {
        background-color: #8B4513 !important;
        color: white !important;
    }
    .cart-item {
        border-bottom: 1px solid #eee;
        padding: 10px 0;
    }
    .cart-item:last-child {
        border-bottom: none;
    }
    .search-box {
        position: relative;
    }
    .search-box i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #999;
    }
    .search-box input {
        padding-left: 40px;
    }
</style>

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-receipt-cutoff"></i> Tạo Đơn hàng - POS</h2>
            <p class="text-muted mb-0">
                <i class="bi bi-shop"></i> @ViewBag.CurrentTenChiNhanh | 
                <i class="bi bi-person"></i> @ViewBag.CurrentTenNhanVien
            </p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <form asp-action="Create" method="post" id="donHangForm">
        <div class="row">
            <!-- Left: Product Menu -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-coffee text-white">
                        <h5 class="mb-0"><i class="bi bi-grid-3x3-gap"></i> Menu sản phẩm</h5>
                    </div>
                    <div class="card-body">
                        <!-- Search Box -->
                        <div class="search-box mb-3">
                            <i class="bi bi-search"></i>
                            <input type="text" id="searchProduct" class="form-control" 
                                   placeholder="Tìm kiếm sản phẩm..." />
                        </div>

                        <!-- Product Grid -->
                        <div class="row g-3" id="productGrid">
                            @foreach (var group in sanPhamGroups)
                            {
                                var sp = group.Key;
                                var bienThes = group.ToList();
                                var firstBienThe = bienThes.First();
                                
                                <div class="col-md-4 col-sm-6 product-item" data-name="@sp.TenSanPham.ToLower()">
                                    <div class="card product-card" onclick="selectProduct('@sp.MaSanPham')">
                                        <div class="card-body p-3">
                                            <div class="text-center mb-2">
                                                <i class="bi bi-cup-hot-fill text-coffee" style="font-size: 3rem;"></i>
                                            </div>
                                            <h6 class="product-name text-center">@sp.TenSanPham</h6>
                                            <p class="product-price text-center mb-2">
                                                @{
                                                    var minPrice = bienThes
                                                        .Select(bt => priceByBienThe.TryGetValue(bt.MaBienThe, out var price)
                                                            ? price
                                                            : sp.GiaCoBan + bt.GiaCongThem)
                                                        .Min();
                                                }
                                                @minPrice.ToString("N0") đ
                                            </p>
                                            <div class="d-flex justify-content-center gap-1 flex-wrap">
                                                @foreach (var bt in bienThes)
                                                {
                                                    var variantPrice = priceByBienThe.TryGetValue(bt.MaBienThe, out var price)
                                                        ? price
                                                        : sp.GiaCoBan + bt.GiaCongThem;
                                                    <span class="badge bg-secondary size-badge" 
                                                          data-product="@sp.MaSanPham"
                                                          data-bienthe="@bt.MaBienThe"
                                                          data-size="@bt.Size"
                                                          title="@variantPrice.ToString("N0") đ"
                                                          onclick="event.stopPropagation(); selectSize('@bt.MaBienThe', '@sp.TenSanPham', '@bt.Size', this)">
                                                        @bt.Size
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (!sanPhamGroups.Any())
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                                <p class="text-muted mt-3">Không có sản phẩm nào trong menu</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right: Cart & Checkout -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-coffee text-white">
                        <h5 class="mb-0"><i class="bi bi-cart3"></i> Giỏ hàng (<span id="cartCount">0</span>)</h5>
                    </div>
                    <div class="card-body">
                        <!-- Cart Items -->
                        <div id="cartItems" style="max-height: 300px; overflow-y: auto;">
                            <div class="text-center text-muted py-4" id="emptyCart">
                                <i class="bi bi-cart-x" style="font-size: 3rem;"></i>
                                <p class="mt-2 mb-0">Giỏ hàng trống</p>
                                <small>Click vào sản phẩm để thêm</small>
                            </div>
                        </div>

                        <hr />

                        <!-- Customer & Payment Info -->
                        <div class="mb-3">
                            <label class="form-label small"><i class="bi bi-person"></i> Khách hàng</label>
                            <select asp-for="MaKH" id="maKhachHangSelect" class="form-select form-select-sm" asp-items="ViewBag.KhachHangs">
                                <option value="">-- Khách vãng lai --</option>
                            </select>
                        </div>

                        <div class="mb-3" id="khachHangInfo">
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle mb-0">
                                    <tbody>
                                        <tr>
                                            <th class="bg-light small fw-semibold" style="width: 42%;">Khách hàng</th>
                                            <td class="small" id="khachHangTen">Khách vãng lai</td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light small fw-semibold">Số điện thoại</th>
                                            <td class="small" id="khachHangSdt">Không áp dụng tích điểm</td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light small fw-semibold">Điểm hiện tại</th>
                                            <td class="small">
                                                <strong class="text-success" id="diemHienCo">0</strong>
                                                <span class="text-muted">điểm</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small"><i class="bi bi-star"></i> Số điểm sử dụng</label>
                            <div class="input-group input-group-sm">
                                <input asp-for="DiemSuDung" type="number" class="form-control"
                                       min="0" id="diemSuDungInput" onchange="tinhTong()" />
                                <span class="input-group-text">điểm</span>
                            </div>
                            <small class="text-muted">1 điểm = 100đ giảm giá, tối đa 10.000đ/đơn</small>
                            <div class="text-danger small mt-1 d-none" id="diemSuDungError"></div>
                            <span asp-validation-for="DiemSuDung" class="text-danger d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small"><i class="bi bi-credit-card"></i> Thanh toán</label>
                            <select asp-for="PhuongThucThanhToan" class="form-select form-select-sm">
                                <option value="Tiền mặt">Tiền mặt</option>
                                <option value="QR">QR Code</option>
                                <option value="Thẻ">Thẻ</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small"><i class="bi bi-percent"></i> Giảm giá thủ công</label>
                            <div class="input-group input-group-sm">
                                <input asp-for="GiamGiaThuCong" type="number" class="form-control" 
                                       min="0" id="giamGiaInput" onchange="tinhTong()" />
                                <span class="input-group-text">đ</span>
                            </div>
                            <span asp-validation-for="GiamGiaThuCong" class="text-danger d-block"></span>
                        </div>

                        <hr />

                        <!-- Summary -->
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính:</span>
                            <strong id="tamTinh">0 đ</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Giảm giá thủ công:</span>
                            <strong class="text-danger" id="giamGiaThuCongDisplay">0 đ</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Điểm sử dụng:</span>
                            <strong id="diemSuDungDisplay">0 điểm</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tiền giảm từ điểm:</span>
                            <strong class="text-danger" id="tienGiamTuDiemDisplay">0 đ</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tổng giảm giá:</span>
                            <strong class="text-danger" id="tongGiamGiaDisplay">0 đ</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3 pt-2 border-top">
                            <h5 class="mb-0">Tổng thanh toán:</h5>
                            <h5 class="mb-0 text-success" id="tongCong">0 đ</h5>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Điểm dự kiến cộng:</span>
                            <strong class="text-success" id="diemCongDisplay">0 điểm</strong>
                        </div>

                        <!-- Action Buttons -->
                        <button type="submit" class="btn btn-coffee w-100 btn-lg mb-2">
                            <i class="bi bi-check-circle"></i> Thanh toán
                        </button>
                        <button type="button" class="btn btn-outline-danger w-100" onclick="clearCart()">
                            <i class="bi bi-trash"></i> Xóa giỏ hàng
                        </button>

                        <!-- Hidden Fields -->
                        <input type="hidden" asp-for="MaChiNhanh" />
                        <input type="hidden" asp-for="MaNV" />
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Size Selection Modal -->
<div class="modal fade" id="sizeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-coffee text-white">
                <h5 class="modal-title"><i class="bi bi-cup-straw"></i> Chọn size</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6 id="modalProductName" class="mb-3"></h6>
                <div id="modalSizeOptions" class="d-grid gap-2">
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let cart = [];
        let currentProduct = null;
        const khachHangInfos = @Html.Raw(khachHangInfosJson);
        const khachHangMap = new Map(khachHangInfos.map(kh => [kh.MaKH, kh]));
        const GIA_TRI_MOI_DIEM = 100;
        const TIEN_GIAM_TU_DIEM_TOI_DA = 10000;
        const DIEM_TOI_DA_THEO_DON = Math.floor(TIEN_GIAM_TU_DIEM_TOI_DA / GIA_TRI_MOI_DIEM);
        const diemSuDungInput = document.getElementById('diemSuDungInput');
        const diemSuDungError = document.getElementById('diemSuDungError');
        const maKhachHangSelect = document.getElementById('maKhachHangSelect');

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Page loaded, cart initialized:', cart);
            updateCustomerInfo();
            renderCart();
        });

        maKhachHangSelect.addEventListener('change', function() {
            updateCustomerInfo();
            tinhTong(true);
        });

        diemSuDungInput.addEventListener('input', function() {
            tinhTong(true);
        });
        document.getElementById('giamGiaInput').addEventListener('input', function() {
            tinhTong();
        });

        // Search products
        document.getElementById('searchProduct').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const products = document.querySelectorAll('.product-item');
            
            products.forEach(product => {
                const name = product.getAttribute('data-name');
                if (name.includes(searchTerm)) {
                    product.style.display = '';
                } else {
                    product.style.display = 'none';
                }
            });
        });

        // Select product (show size options)
        function selectProduct(maSanPham) {
            const sizeBadges = document.querySelectorAll(`[data-product="${maSanPham}"]`);
            const productCard = document.querySelector(`[data-product="${maSanPham}"]`).closest('.product-card');
            const productName = productCard.querySelector('.product-name').textContent.trim();
            
            if (sizeBadges.length === 1) {
                // Only one size, add directly
                const badge = sizeBadges[0];
                selectSize(
                    badge.getAttribute('data-bienthe'),
                    productName,
                    badge.getAttribute('data-size'),
                    badge
                );
            } else {
                // Multiple sizes, show modal
                document.getElementById('modalProductName').textContent = productName;
                
                const modalOptions = document.getElementById('modalSizeOptions');
                modalOptions.innerHTML = '';
                
                sizeBadges.forEach(badge => {
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-outline-coffee btn-lg';
                    btn.textContent = badge.getAttribute('data-size');
                    btn.onclick = () => {
                        selectSize(
                            badge.getAttribute('data-bienthe'),
                            productName,
                            badge.getAttribute('data-size'),
                            badge
                        );
                        bootstrap.Modal.getInstance(document.getElementById('sizeModal')).hide();
                    };
                    modalOptions.appendChild(btn);
                });
                
                new bootstrap.Modal(document.getElementById('sizeModal')).show();
            }
        }

        // Select size and add to cart
        async function selectSize(maBienThe, tenSanPham, size, badge) {
            console.log('selectSize called:', { maBienThe, tenSanPham, size });
            
            try {
                const response = await fetch('/DonHang/GetBienThePrice?id=' + maBienThe);
                const data = await response.json();

                console.log('Price data:', data);

                if (!data.success) {
                    showToast('Không tìm thấy sản phẩm', 'error');
                    return;
                }

                const existing = cart.find(item => item.maBienThe === maBienThe);
                if (existing) {
                    existing.soLuong += 1;
                    console.log('Updated existing item:', existing);
                } else {
                    const newItem = {
                        maBienThe: maBienThe,
                        tenSanPham: tenSanPham,
                        size: size,
                        donGia: data.price,
                        soLuong: 1
                    };
                    cart.push(newItem);
                    console.log('Added new item:', newItem);
                }

                console.log('Current cart:', cart);

                // Visual feedback
                if (badge) {
                    badge.classList.add('active');
                    setTimeout(() => badge.classList.remove('active'), 300);
                }

                renderCart();
                showToast(`Đã thêm ${tenSanPham} (${size})`, 'success');
            } catch (error) {
                console.error('Error in selectSize:', error);
                showToast('Có lỗi xảy ra: ' + error.message, 'error');
            }
        }

        // Render cart
        function renderCart() {
            console.log('renderCart called, cart:', cart);
            
            const cartItems = document.getElementById('cartItems');
            const emptyCart = document.getElementById('emptyCart');
            const cartCount = document.getElementById('cartCount');

            if (cart.length === 0) {
                if (!emptyCart) {
                    const emptyDiv = document.createElement('div');
                    emptyDiv.id = 'emptyCart';
                    emptyDiv.className = 'text-center text-muted py-4';
                    emptyDiv.innerHTML = `
                        <i class="bi bi-cart-x" style="font-size: 3rem;"></i>
                        <p class="mt-2">Giỏ hàng trống</p>
                    `;
                    cartItems.innerHTML = '';
                    cartItems.appendChild(emptyDiv);
                } else {
                    emptyCart.style.display = 'block';
                    cartItems.innerHTML = '';
                    cartItems.appendChild(emptyCart);
                }
                cartCount.textContent = '0';
            } else {
                if (emptyCart) {
                    emptyCart.style.display = 'none';
                }
                cartItems.innerHTML = '';
                
                cart.forEach((item, index) => {
                    const thanhTien = item.donGia * item.soLuong;
                    const itemDiv = document.createElement('div');
                    itemDiv.className = 'cart-item';
                    itemDiv.innerHTML = `
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="flex-grow-1">
                                <strong class="d-block">${item.tenSanPham}</strong>
                                <small class="text-muted">Size: ${item.size}</small>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" 
                                    onclick="xoaSanPham('${item.maBienThe}')" title="Xóa">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary" 
                                        onclick="updateQuantity('${item.maBienThe}', -1)">
                                    <i class="bi bi-dash"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" disabled>
                                    ${item.soLuong}
                                </button>
                                <button type="button" class="btn btn-outline-secondary" 
                                        onclick="updateQuantity('${item.maBienThe}', 1)">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </div>
                            <strong class="text-coffee">${formatMoney(thanhTien)}</strong>
                        </div>
                    `;
                    cartItems.appendChild(itemDiv);
                });

                cartCount.textContent = cart.length;
            }

            tinhTong();
            console.log('Cart rendered successfully');
        }

        // Update quantity
        function updateQuantity(maBienThe, change) {
            const item = cart.find(i => i.maBienThe === maBienThe);
            if (item) {
                item.soLuong += change;
                if (item.soLuong <= 0) {
                    xoaSanPham(maBienThe);
                } else {
                    renderCart();
                }
            }
        }

        // Remove item
        function xoaSanPham(maBienThe) {
            cart = cart.filter(item => item.maBienThe !== maBienThe);
            renderCart();
        }

        // Clear cart
        function clearCart() {
            if (cart.length === 0) return;
            
            if (confirm('Bạn có chắc muốn xóa toàn bộ giỏ hàng?')) {
                cart = [];
                renderCart();
                showToast('Đã xóa giỏ hàng', 'info');
            }
        }

        // Calculate total
        function tinhTong(showPointError = false) {
            const tamTinh = cart.reduce((sum, item) => sum + (item.donGia * item.soLuong), 0);
            const giamGiaInput = document.getElementById('giamGiaInput');
            const pointState = normalizeDiemSuDung(showPointError);
            const selectedCustomer = pointState.selectedCustomer;
            let giamGiaThuCong = parseFloat(giamGiaInput.value) || 0;
            let diemSuDung = pointState.diemSuDung;

            let tienGiamTuDiem = diemSuDung * GIA_TRI_MOI_DIEM;
            let tongGiamGia = giamGiaThuCong + tienGiamTuDiem;

            if (tongGiamGia > tamTinh) {
                const maxGiamGiaThuCong = Math.max(0, tamTinh - tienGiamTuDiem);
                giamGiaThuCong = maxGiamGiaThuCong;
                giamGiaInput.value = maxGiamGiaThuCong;
                tongGiamGia = giamGiaThuCong + tienGiamTuDiem;
            }

            const tongCong = Math.max(0, tamTinh - tongGiamGia);
            const diemCong = selectedCustomer ? Math.floor(tongCong / 10000) : 0;

            document.getElementById('tamTinh').textContent = formatMoney(tamTinh);
            document.getElementById('giamGiaThuCongDisplay').textContent = formatMoney(giamGiaThuCong);
            document.getElementById('diemSuDungDisplay').textContent = `${diemSuDung} điểm`;
            document.getElementById('tienGiamTuDiemDisplay').textContent = formatMoney(tienGiamTuDiem);
            document.getElementById('tongGiamGiaDisplay').textContent = formatMoney(tongGiamGia);
            document.getElementById('tongCong').textContent = formatMoney(tongCong);
            document.getElementById('diemCongDisplay').textContent = `${diemCong} điểm`;
        }

        function normalizeDiemSuDung(showMessage) {
            const selectedCustomer = khachHangMap.get(maKhachHangSelect.value);
            const diemHienCo = selectedCustomer ? selectedCustomer.DiemTichLuy : 0;
            const diemToiDaDuocDung = selectedCustomer ? Math.min(diemHienCo, DIEM_TOI_DA_THEO_DON) : 0;
            const rawValue = diemSuDungInput.value;
            let diemSuDung = parseInt(rawValue, 10);
            let message = '';

            if (Number.isNaN(diemSuDung)) {
                diemSuDung = 0;
            }

            if (diemSuDung < 0) {
                diemSuDung = 0;
                message = 'Không được nhập điểm âm. Hệ thống đã đưa điểm sử dụng về 0.';
            } else if (!selectedCustomer && diemSuDung > 0) {
                diemSuDung = 0;
                message = 'Khách vãng lai không được sử dụng điểm.';
            } else if (diemSuDung > diemToiDaDuocDung) {
                diemSuDung = diemToiDaDuocDung;
                message = diemHienCo > DIEM_TOI_DA_THEO_DON
                    ? `Tiền giảm từ điểm tối đa là 10.000đ/đơn. Hệ thống đã lấy tối đa ${DIEM_TOI_DA_THEO_DON} điểm.`
                    : `Số điểm sử dụng vượt quá điểm hiện có. Hệ thống đã lấy tối đa ${diemHienCo} điểm.`;
            }

            if (rawValue !== diemSuDung.toString()) {
                diemSuDungInput.value = diemSuDung;
            }

            setDiemSuDungError(message);
            if (showMessage && message) {
                showToast(message, 'error');
            }

            return {
                selectedCustomer,
                diemHienCo,
                diemSuDung
            };
        }

        function setDiemSuDungError(message) {
            diemSuDungError.textContent = message;
            diemSuDungError.classList.toggle('d-none', !message);
        }

        function updateCustomerInfo() {
            const selectedCustomer = khachHangMap.get(maKhachHangSelect.value);

            if (!selectedCustomer) {
                document.getElementById('khachHangTen').textContent = 'Khách vãng lai';
                document.getElementById('khachHangSdt').textContent = 'Không áp dụng tích điểm';
                document.getElementById('diemHienCo').textContent = '0';
                diemSuDungInput.value = 0;
                diemSuDungInput.disabled = true;
                setDiemSuDungError('');
                return;
            }

            document.getElementById('khachHangTen').textContent = selectedCustomer.TenKH;
            document.getElementById('khachHangSdt').textContent = selectedCustomer.SoDienThoai;
            document.getElementById('diemHienCo').textContent = selectedCustomer.DiemTichLuy;
            diemSuDungInput.disabled = false;
        }

        // Format money
        function formatMoney(amount) {
            return new Intl.NumberFormat('vi-VN', { 
                style: 'currency', 
                currency: 'VND' 
            }).format(amount);
        }

        // Show toast notification
        function showToast(message, type) {
            const toastContainer = document.getElementById('toastContainer') || createToastContainer();
            
            const toast = document.createElement('div');
            toast.className = `alert alert-${type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info'} alert-dismissible fade show`;
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <i class="bi bi-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-triangle' : 'info-circle'}"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            toastContainer.appendChild(toast);
            
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 150);
            }, 3000);
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.id = 'toastContainer';
            container.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            document.body.appendChild(container);
            return container;
        }

        // Form submit
        document.getElementById('donHangForm').addEventListener('submit', function(e) {
            if (cart.length === 0) {
                e.preventDefault();
                showToast('Vui lòng thêm ít nhất một sản phẩm', 'error');
                return;
            }

            const tamTinh = cart.reduce((sum, item) => sum + (item.donGia * item.soLuong), 0);
            const pointState = normalizeDiemSuDung(true);
            const selectedCustomer = pointState.selectedCustomer;
            const diemSuDung = pointState.diemSuDung;
            const giamGiaThuCong = parseFloat(document.getElementById('giamGiaInput').value) || 0;
            const tienGiamTuDiem = diemSuDung * GIA_TRI_MOI_DIEM;
            const tongGiamGia = giamGiaThuCong + tienGiamTuDiem;

            if (!selectedCustomer && diemSuDung > 0) {
                e.preventDefault();
                showToast('Khách vãng lai không được sử dụng điểm', 'error');
                return;
            }

            if (selectedCustomer && diemSuDung > selectedCustomer.DiemTichLuy) {
                e.preventDefault();
                showToast('Số điểm sử dụng không được vượt quá điểm hiện có', 'error');
                return;
            }

            if (tienGiamTuDiem > TIEN_GIAM_TU_DIEM_TOI_DA) {
                e.preventDefault();
                showToast('Tiền giảm từ điểm tối đa là 10.000đ cho mỗi đơn hàng', 'error');
                return;
            }

            if (tongGiamGia > tamTinh) {
                e.preventDefault();
                showToast('Tổng giảm giá không được vượt quá tạm tính', 'error');
                return;
            }

            this.querySelectorAll('input[data-cart-field="true"]').forEach(input => input.remove());

            // Add cart items to form. Unit price is intentionally not posted; server calculates it from DB.
            cart.forEach((item, index) => {
                const input1 = document.createElement('input');
                input1.type = 'hidden';
                input1.name = `ChiTietDonHangs[${index}].MaBienThe`;
                input1.value = item.maBienThe;
                input1.dataset.cartField = 'true';
                this.appendChild(input1);

                const input2 = document.createElement('input');
                input2.type = 'hidden';
                input2.name = `ChiTietDonHangs[${index}].SoLuong`;
                input2.value = item.soLuong;
                input2.dataset.cartField = 'true';
                this.appendChild(input2);
            });
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl/Cmd + Enter to submit
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                if (cart.length > 0) {
                    document.getElementById('donHangForm').requestSubmit();
                }
            }
            // Escape to clear search
            if (e.key === 'Escape') {
                document.getElementById('searchProduct').value = '';
                document.getElementById('searchProduct').dispatchEvent(new Event('input'));
            }
        });
    </script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
