@model CaLamViec
@{
    ViewData["Title"] = "Sửa Ca làm việc";
}

<div class="container-fluid p-4">
    <h2><i class="bi bi-pencil"></i> Sửa Ca làm việc: @Model.MaCa</h2>

    <div class="card mt-3">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <strong>Có lỗi xảy ra:</strong>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaCa" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Mã ca</label>
                        <input type="text" class="form-control" value="@Model.MaCa" disabled />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="TenCa" class="form-label">Tên ca <span class="text-danger">*</span></label>
                        <input asp-for="TenCa" class="form-control" maxlength="100" required />
                        <span asp-validation-for="TenCa" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="LoaiCa" class="form-label">Loại ca <span class="text-danger">*</span></label>
                        <select asp-for="LoaiCa" class="form-select" required>
                            <option value="1">Fulltime</option>
                            <option value="2">Parttime</option>
                        </select>
                        <span asp-validation-for="LoaiCa" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="HeSoCa" class="form-label">Hệ số ca <span class="text-danger">*</span></label>
                        <input asp-for="HeSoCa" type="number" step="0.01" min="0.01" class="form-control" required />
                        <span asp-validation-for="HeSoCa" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="GioBatDau" class="form-label">Giờ bắt đầu <span class="text-danger">*</span></label>
                        <input asp-for="GioBatDau" type="time" class="form-control" required />
                        <span asp-validation-for="GioBatDau" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="GioKetThuc" class="form-label">Giờ kết thúc <span class="text-danger">*</span></label>
                        <input asp-for="GioKetThuc" type="time" class="form-control" required />
                        <span asp-validation-for="GioKetThuc" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-coffee">
                        <i class="bi bi-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
