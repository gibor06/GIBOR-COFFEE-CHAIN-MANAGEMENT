@model ChamCong
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Thêm Chấm công";
}

<div class="container-fluid p-4">
    <h2><i class="bi bi-plus-circle"></i> Thêm Chấm công</h2>

    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Chọn lịch phân công, nhập giờ vào/ra. Hệ thống sẽ tự động tính trạng thái, hệ số và lương thực tế.
    </div>

    <div class="card mt-3">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <strong>Có lỗi xảy ra:</strong>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="MaLich" class="form-label">Lịch phân công <span class="text-danger">*</span></label>
                        <select asp-for="MaLich" class="form-select" required>
                            <option value="">-- Chọn lịch phân công --</option>
                            @if (ViewBag.LichPhanCongs != null)
                            {
                                @foreach (SelectListItem lich in ViewBag.LichPhanCongs)
                                {
                                    <option value="@lich.Value">@lich.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="MaLich" class="text-danger"></span>
                        <small class="text-muted">Chỉ hiển thị lịch trạng thái "Đã phân công" và chưa chấm công.</small>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="GioVao" class="form-label">Giờ vào <span class="text-danger">*</span></label>
                        <input asp-for="GioVao" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="GioVao" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="GioRa" class="form-label">Giờ ra <span class="text-danger">*</span></label>
                        <input asp-for="GioRa" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="GioRa" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-coffee">
                        <i class="bi bi-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
