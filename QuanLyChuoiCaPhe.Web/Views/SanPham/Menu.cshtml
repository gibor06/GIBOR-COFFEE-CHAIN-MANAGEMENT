@model IEnumerable<VwMenuChiNhanh>
@{
    ViewData["Title"] = "Menu Sản phẩm";
}

<style>
    .menu-page {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        padding: 30px 0;
    }
    .menu-header {
        background: linear-gradient(135deg, #8B4513 0%, #D2691E 100%);
        color: white;
        padding: 40px;
        border-radius: 15px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(139, 69, 19, 0.3);
        text-align: center;
    }
    .menu-header h2 {
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }
    .branch-info {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 25px;
    }
    .branch-name {
        font-size: 1.3rem;
        font-weight: 600;
        color: #27ae60;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .category-section {
        margin-bottom: 40px;
    }
    .branch-section {
        margin-bottom: 60px;
        padding: 30px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }
    .branch-section-header {
        background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
        color: white;
        padding: 25px 35px;
        border-radius: 12px;
        margin-bottom: 30px;
        box-shadow: 0 6px 20px rgba(39, 174, 96, 0.3);
    }
    .branch-section-header h3 {
        margin: 0;
        font-size: 1.8rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 15px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }
    .branch-section-header i {
        font-size: 2rem;
    }
    .category-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px 30px;
        border-radius: 12px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }
    .category-header h5 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .menu-item-card {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        height: 100%;
        border: 2px solid transparent;
    }
    .menu-item-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.2);
        border-color: #8B4513;
    }
    .menu-item-image {
        background: linear-gradient(135deg, #8B4513 0%, #D2691E 100%);
        height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }
    .menu-item-image::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        animation: shimmer 3s infinite;
    }
    @@keyframes shimmer {
        0%, 100% { transform: translate(0, 0); }
        50% { transform: translate(10%, 10%); }
    }
    .menu-item-image i {
        font-size: 5rem;
        color: rgba(255,255,255,0.9);
        z-index: 1;
    }
    .menu-item-body {
        padding: 20px;
    }
    .menu-item-name {
        font-size: 1.2rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 15px;
        min-height: 50px;
        display: flex;
        align-items: center;
    }
    .size-options {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 15px;
    }
    .size-option {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 12px;
        background: white;
        border-radius: 8px;
        margin-bottom: 8px;
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }
    .size-option:last-child {
        margin-bottom: 0;
    }
    .size-option:hover {
        border-color: #8B4513;
        transform: translateX(5px);
        box-shadow: 0 2px 8px rgba(139, 69, 19, 0.2);
    }
    .size-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
        color: #495057;
    }
    .size-label i {
        color: #8B4513;
        font-size: 1.1rem;
    }
    .size-name {
        font-size: 1rem;
        font-weight: 600;
    }
    .size-price {
        font-size: 1.3rem;
        font-weight: 700;
        color: #27ae60;
        white-space: nowrap;
    }
    .menu-item-status {
        text-align: center;
        padding: 10px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.95rem;
    }
    .status-available {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
    }
    .status-unavailable {
        background: linear-gradient(135deg, #bdc3c7 0%, #95a5a6 100%);
        color: white;
    }
    .filter-section {
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 30px;
    }
    .empty-menu {
        text-align: center;
        padding: 80px 20px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .empty-menu i {
        font-size: 5rem;
        color: #bdc3c7;
        margin-bottom: 20px;
    }
    .empty-menu h4 {
        color: #7f8c8d;
        margin-bottom: 10px;
    }
    .btn-back {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }
    .btn-back:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
        color: white;
    }
    .menu-stats {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 15px;
    }
    .stat-item {
        background: rgba(255,255,255,0.2);
        padding: 10px 20px;
        border-radius: 8px;
        backdrop-filter: blur(10px);
    }
    .stat-item strong {
        font-size: 1.5rem;
    }
</style>

<div class="menu-page">
    <div class="container-fluid px-4">
        <div class="menu-header">
            <h2><i class="bi bi-menu-button-wide-fill"></i> Menu Sản phẩm GIBOR Coffee</h2>
            @if (Model.Any())
            {
                var totalProducts = Model.Select(m => m.TenSanPham).Distinct().Count();
                var totalVariants = Model.Count();
                var categories = Model.Select(m => m.TenDanhMuc).Distinct().Count();
                var branchName = Model.First().TenChiNhanh;
                <div class="menu-stats">
                    <div class="stat-item">
                        <i class="bi bi-shop-window"></i> <strong>@branchName</strong>
                    </div>
                    <div class="stat-item">
                        <i class="bi bi-cup-hot-fill"></i> <strong>@totalProducts</strong> sản phẩm
                    </div>
                    <div class="stat-item">
                        <i class="bi bi-grid-3x3-gap-fill"></i> <strong>@categories</strong> danh mục
                    </div>
                </div>
            }
        </div>

        <div class="filter-section">
            <form method="get" class="row g-3 align-items-end">
                @if (ViewBag.CurrentVaiTro == "QUAN_LY" || ViewBag.CurrentVaiTro == "NHAN_VIEN")
                {
                    <!-- Nhân viên/Quản lý: Hiển thị chi nhánh cố định -->
                    var currentBranch = (ViewBag.ChiNhanhs as List<ChiNhanh>)?.FirstOrDefault(c => c.MaChiNhanh == ViewBag.CurrentMaChiNhanh);
                    <div class="col-md-8">
                        <div class="branch-name">
                            <i class="bi bi-shop-window"></i>
                            <span>Chi nhánh: GIBOR Coffee @(currentBranch?.TenChiNhanh ?? "")</span>
                        </div>
                        <input type="hidden" name="chiNhanh" value="@ViewBag.CurrentMaChiNhanh" />
                    </div>
                }
                else
                {
                    <!-- Admin: Hiển thị combobox chọn chi nhánh -->
                    <div class="col-md-8">
                        <label class="form-label fw-bold"><i class="bi bi-shop"></i> Chọn chi nhánh</label>
                        <select name="chiNhanh" class="form-select form-select-lg">
                            @foreach (var cn in ViewBag.ChiNhanhs as List<ChiNhanh>)
                            {
                                <option value="@cn.MaChiNhanh" selected="@(ViewBag.ChiNhanh == cn.MaChiNhanh)">
                                    GIBOR Coffee @cn.TenChiNhanh
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-funnel-fill"></i> Xem menu
                        </button>
                        <a asp-action="Index" class="btn btn-back w-100 mt-2">
                            <i class="bi bi-arrow-left-circle"></i> Quay lại
                        </a>
                    </div>
                }
            </form>
        </div>

        @if (Model.Any())
        {
            <!-- Hiển thị menu của 1 chi nhánh duy nhất -->
            var branchName = Model.First().TenChiNhanh;
            var categoriesInBranch = Model.GroupBy(m => m.TenDanhMuc).OrderBy(g => g.Key);
            
            <div class="branch-section mb-5">                
                @foreach (var categoryGroup in categoriesInBranch)
                {
                    <div class="category-section">
                        <div class="category-header">
                            <h5>
                                <i class="bi bi-cup-hot-fill"></i>
                                @categoryGroup.Key
                                <span class="badge bg-light text-dark ms-2">@categoryGroup.Select(x => x.TenSanPham).Distinct().Count() món</span>
                            </h5>
                        </div>
                        <div class="row g-4">
                            @{
                                var productsInCategory = categoryGroup.GroupBy(m => m.TenSanPham).OrderBy(g => g.Key);
                            }
                            @foreach (var productGroup in productsInCategory)
                            {
                                var sizes = productGroup.OrderBy(p => p.Size).ToList();
                                var firstItem = sizes.First();
                                
                                <div class="col-xl-3 col-lg-4 col-md-6">
                                    <div class="menu-item-card">
                                        <div class="menu-item-image">
                                            <i class="bi bi-cup-hot-fill"></i>
                                        </div>
                                        <div class="menu-item-body">
                                            <div class="menu-item-name">
                                                @productGroup.Key
                                            </div>
                                            
                                            <div class="size-options mb-3">
                                                @foreach (var sizeItem in sizes)
                                                {
                                                    <div class="size-option">
                                                        <div class="size-label">
                                                            <i class="bi bi-cup"></i>
                                                            <span class="size-name">@sizeItem.Size</span>
                                                        </div>
                                                        <div class="size-price">
                                                            @sizeItem.GiaBanThucTe?.ToString("N0") đ
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            
                                            <div class="menu-item-status @(firstItem.TrangThaiMenu == true ? "status-available" : "status-unavailable")">
                                                @if (firstItem.TrangThaiMenu == true)
                                                {
                                                    <i class="bi bi-check-circle-fill"></i> <span>Còn hàng</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-x-circle-fill"></i> <span>Hết hàng</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-menu">
                <i class="bi bi-inbox"></i>
                @if (ViewBag.ChiNhanh == null)
                {
                    <h4>Không có chi nhánh nào trong hệ thống</h4>
                    <p class="text-muted">Vui lòng thêm chi nhánh trước khi xem menu</p>
                }
                else
                {
                    <h4>Chưa có sản phẩm nào trong menu</h4>
                    <p class="text-muted">Chi nhánh này chưa có sản phẩm hoặc tất cả sản phẩm đang tạm ngưng</p>
                }
                <a asp-action="Index" class="btn btn-back mt-3">
                    <i class="bi bi-arrow-left-circle"></i> Quay lại quản lý sản phẩm
                </a>
            </div>
        }
    </div>
</div>
