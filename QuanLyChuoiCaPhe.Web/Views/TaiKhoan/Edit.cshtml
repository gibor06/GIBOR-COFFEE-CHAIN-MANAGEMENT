@model HeThongTaiKhoan
@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
    var nhanVien = Model.TaiKhoanNhanViens.FirstOrDefault()?.ThongTinNhanVien;
}

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-pencil-square"></i> Chỉnh sửa tài khoản</h2>
            <p class="text-muted mb-0">Cập nhật thông tin tài khoản @Model.TenDangNhap</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="MaTK" />
                        <input type="hidden" asp-for="MatKhauHash" />
                        <input type="hidden" asp-for="NgayTao" />

                        <!-- Account Information -->
                        <h5 class="mb-3 pb-2 border-bottom">
                            <i class="bi bi-person-badge"></i> Thông tin tài khoản
                        </h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Mã tài khoản</label>
                                <input type="text" class="form-control" value="@Model.MaTK" disabled />
                                <small class="form-text text-muted">Mã tài khoản không thể thay đổi</small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Ngày tạo</label>
                                <input type="text" class="form-control" 
                                       value="@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")" disabled />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="TenDangNhap" class="form-label">
                                    Tên đăng nhập <span class="text-danger">*</span>
                                </label>
                                <input asp-for="TenDangNhap" class="form-control" 
                                       placeholder="Nhập tên đăng nhập" />
                                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="VaiTro" class="form-label">
                                    Vai trò <span class="text-danger">*</span>
                                </label>
                                <select asp-for="VaiTro" class="form-select">
                                    <option value="">-- Chọn vai trò --</option>
                                    <option value="ADMIN">ADMIN - Quản trị viên</option>
                                    <option value="QUAN_LY">QUẢN LÝ - Quản lý chi nhánh</option>
                                    <option value="NHAN_VIEN">NHÂN VIÊN - Nhân viên bán hàng</option>
                                    <option value="KHO">KHO - Quản lý kho</option>
                                    <option value="KE_TOAN">KẾ TOÁN - Kế toán</option>
                                </select>
                                <span asp-validation-for="VaiTro" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Employee Link Info (Read-only) -->
                        @if (nhanVien != null)
                        {
                            <h5 class="mb-3 pb-2 border-bottom mt-4">
                                <i class="bi bi-person-lines-fill"></i> Nhân viên liên kết
                            </h5>

                            <div class="alert alert-info">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-person-check-fill me-2" style="font-size: 1.5rem;"></i>
                                    <div>
                                        <strong>@nhanVien.HoTenNV</strong> (@nhanVien.MaNV)
                                        <br>
                                        <small>
                                            @(nhanVien.ChucVuNhanVien?.TenChucVu ?? "N/A") - 
                                            @(nhanVien.ChiNhanh?.TenChiNhanh ?? "N/A")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Status -->
                        <h5 class="mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-toggle-on"></i> Trạng thái
                        </h5>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="TrangThai" class="form-check-input" type="checkbox" 
                                       role="switch" id="trangThaiSwitch" />
                                <label class="form-check-label" for="trangThaiSwitch">
                                    <strong>Kích hoạt tài khoản</strong>
                                    <br>
                                    <small class="text-muted">
                                        Tài khoản @(Model.TrangThai ? "có thể" : "không thể") đăng nhập
                                    </small>
                                </label>
                            </div>
                        </div>

                        <!-- Password Notice -->
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle"></i> 
                            <strong>Lưu ý:</strong> Để thay đổi mật khẩu, vui lòng sử dụng chức năng 
                            <a asp-action="ResetPassword" asp-route-id="@Model.MaTK" class="alert-link">
                                "Đặt lại mật khẩu"
                            </a>.
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 justify-content-end pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Hủy
                            </a>
                            <a asp-action="ResetPassword" asp-route-id="@Model.MaTK" class="btn btn-warning">
                                <i class="bi bi-key"></i> Đặt lại mật khẩu
                            </a>
                            <button type="submit" class="btn btn-coffee">
                                <i class="bi bi-save"></i> Cập nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
