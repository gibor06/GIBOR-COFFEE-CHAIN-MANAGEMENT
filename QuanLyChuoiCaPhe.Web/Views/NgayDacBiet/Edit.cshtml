@model NgayDacBiet
@{
    ViewData["Title"] = "Sửa Ngày đặc biệt";
}

<div class="container-fluid p-4">
    <h2><i class="bi bi-pencil"></i> Sửa Ngày đặc biệt: @Model.Ngay.ToString("dd/MM/yyyy")</h2>

    <div class="card mt-3">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <strong>Có lỗi xảy ra:</strong>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Ngay" />

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Ngày</label>
                        <input type="text" class="form-control" value="@Model.Ngay.ToString("dd/MM/yyyy")" disabled />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="TenNgay" class="form-label">Tên ngày <span class="text-danger">*</span></label>
                        <input asp-for="TenNgay" class="form-control" maxlength="100" required />
                        <span asp-validation-for="TenNgay" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="HeSoLuong" class="form-label">Hệ số lương <span class="text-danger">*</span></label>
                        <input asp-for="HeSoLuong" type="number" step="0.01" min="1" class="form-control" required />
                        <span asp-validation-for="HeSoLuong" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-coffee">
                        <i class="bi bi-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
