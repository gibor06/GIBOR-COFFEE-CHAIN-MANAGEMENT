@model KhoKhoiTaoViewModel
@{
    ViewData["Title"] = "Khởi tạo Tồn kho";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-plus-circle"></i> Khởi tạo Tồn kho</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="card">
        <div class="card-header bg-coffee text-white">
            <h5><i class="bi bi-box-seam"></i> Thông tin khởi tạo</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> 
                <strong>Lưu ý:</strong> Chức năng này dùng để khởi tạo tồn kho ban đầu cho nguyên liệu chưa có trong kho của chi nhánh. 
                Sau khi khởi tạo, số lượng tồn sẽ là 0, bạn có thể nhập kho để tăng số lượng.
            </div>

            <form asp-action="KhoiTao" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="MaChiNhanh" class="form-label">Chi nhánh <span class="text-danger">*</span></label>
                        <select asp-for="MaChiNhanh" class="form-select" asp-items="ViewBag.ChiNhanhs">
                            <option value="">-- Chọn chi nhánh --</option>
                        </select>
                        <span asp-validation-for="MaChiNhanh" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="MaNguyenLieu" class="form-label">Nguyên liệu <span class="text-danger">*</span></label>
                        <select asp-for="MaNguyenLieu" class="form-select" asp-items="ViewBag.NguyenLieus">
                            <option value="">-- Chọn nguyên liệu --</option>
                        </select>
                        <span asp-validation-for="MaNguyenLieu" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="MucCanhBao" class="form-label">Mức cảnh báo <span class="text-danger">*</span></label>
                        <input asp-for="MucCanhBao" type="number" step="0.01" class="form-control" placeholder="Nhập mức cảnh báo" min="0" />
                        <div class="form-text">Khi tồn kho <= mức này sẽ hiển thị cảnh báo</div>
                        <span asp-validation-for="MucCanhBao" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="HanSuDung" class="form-label">Hạn sử dụng</label>
                        <input asp-for="HanSuDung" type="date" class="form-control" />
                        <div class="form-text">Để trống nếu nguyên liệu không có hạn sử dụng</div>
                        <span asp-validation-for="HanSuDung" class="text-danger"></span>
                    </div>
                </div>

                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Sau khi khởi tạo:</strong>
                    <ul class="mb-0 mt-2">
                        <li>Số lượng tồn ban đầu: <strong>0</strong></li>
                        <li>Số lượng đã đặt: <strong>0</strong></li>
                        <li>Bạn cần vào <strong>"Giao dịch Kho"</strong> để nhập nguyên liệu vào kho</li>
                    </ul>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-coffee">
                        <i class="bi bi-check-circle"></i> Khởi tạo
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
