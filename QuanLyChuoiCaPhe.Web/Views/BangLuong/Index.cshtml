@model IEnumerable<BangLuong>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Quản lý Bảng lương";
}

@Html.AntiForgeryToken()

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-cash-stack"></i> Quản lý Bảng lương</h2>
        <div>
            @if (ViewBag.IsAdmin || ViewBag.IsKeToan)
            {
                <a asp-action="KhoiTao" class="btn btn-outline-primary me-1">
                    <i class="bi bi-lightning"></i> Khởi tạo lương
                </a>
            }
            <a asp-action="Create" class="btn btn-coffee">
                <i class="bi bi-plus-circle"></i> Thêm bảng lương
            </a>
        </div>
    </div>

    <!-- Card thống kê -->
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h6 class="card-title mb-1">Tổng lương ca</h6>
                    <h5 class="mb-0">@(((decimal)ViewBag.TongLuongCa).ToString("N0")) đ</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h6 class="card-title mb-1">Tổng thưởng</h6>
                    <h5 class="mb-0">@(((decimal)ViewBag.TongThuong).ToString("N0")) đ</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body text-center">
                    <h6 class="card-title mb-1">Tổng khấu trừ</h6>
                    <h5 class="mb-0">@(((decimal)ViewBag.TongKhauTru).ToString("N0")) đ</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <h6 class="card-title mb-1">Tổng thực lãnh</h6>
                    <h5 class="mb-0">@(((decimal)ViewBag.TongThucLanh).ToString("N0")) đ</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Form lọc -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <select name="thang" class="form-select">
                        <option value="">-- Tháng --</option>
                        @for (byte i = 1; i <= 12; i++)
                        {
                            <option value="@i" selected="@(ViewBag.Thang != null && (byte)ViewBag.Thang == i)">Tháng @i</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="nam" class="form-select">
                        <option value="">-- Năm --</option>
                        @for (short i = 2024; i <= 2030; i++)
                        {
                            <option value="@i" selected="@(ViewBag.Nam != null && (short)ViewBag.Nam == i)">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="maNV" class="form-select">
                        <option value="">-- Nhân viên --</option>
                        @if (ViewBag.NhanViens != null)
                        {
                            @foreach (SelectListItem nv in ViewBag.NhanViens)
                            {
                                <option value="@nv.Value" selected="@(ViewBag.MaNV == nv.Value)">@nv.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="trangThai" class="form-select">
                        <option value="">-- Trạng thái --</option>
                        <option value="Tạm tính" selected="@(ViewBag.TrangThaiFilter == "Tạm tính")">Tạm tính</option>
                        <option value="Đã thanh toán" selected="@(ViewBag.TrangThaiFilter == "Đã thanh toán")">Đã thanh toán</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-clockwise"></i> Làm mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Mã NV</th>
                            <th>Nhân viên</th>
                            <th>Tháng/Năm</th>
                            <th>Tổng giờ</th>
                            <th>Lương ca</th>
                            <th>Thưởng</th>
                            <th>Khấu trừ</th>
                            <th>Thực lãnh</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MaNV</td>
                                <td><strong>@item.ThongTinNhanVien?.HoTenNV</strong></td>
                                <td>@item.Thang/@item.Nam</td>
                                <td>@item.TongGioThucTe.ToString("N2")</td>
                                <td>@item.TongLuongCa.ToString("N0") đ</td>
                                <td>@item.TongThuong.ToString("N0") đ</td>
                                <td class="text-danger">@item.TongKhauTru.ToString("N0") đ</td>
                                <td class="text-success"><strong>@(item.ThucLanh?.ToString("N0") ?? "0") đ</strong></td>
                                <td>
                                    @if (item.TrangThai == "Đã thanh toán")
                                    {
                                        <span class="badge bg-success">Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Tạm tính</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TrangThai == "Tạm tính")
                                    {
                                        <a asp-action="Edit" asp-route-maNV="@item.MaNV" asp-route-thang="@item.Thang" asp-route-nam="@item.Nam" class="btn btn-sm btn-primary" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (ViewBag.IsAdmin || ViewBag.IsKeToan)
                                        {
                                            <button type="button" class="btn btn-sm btn-success" onclick="xacNhanThanhToan('@item.MaNV', @item.Thang, @item.Nam)" title="Xác nhận thanh toán">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="xoaBangLuong('@item.MaNV', @item.Thang, @item.Nam)" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p>Không có dữ liệu bảng lương.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function xacNhanThanhToan(maNV, thang, nam) {
            if (confirm('Xác nhận đã thanh toán lương cho nhân viên này?')) {
                fetch('/BangLuong/XacNhanThanhToan?maNV=' + encodeURIComponent(maNV) + '&thang=' + thang + '&nam=' + nam, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(data.message, 'error');
                    }
                });
            }
        }

        function xoaBangLuong(maNV, thang, nam) {
            if (confirm('Bạn có chắc chắn muốn xóa bảng lương này?')) {
                fetch('/BangLuong/Delete?maNV=' + encodeURIComponent(maNV) + '&thang=' + thang + '&nam=' + nam, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(data.message, 'error');
                    }
                });
            }
        }
    </script>
}
