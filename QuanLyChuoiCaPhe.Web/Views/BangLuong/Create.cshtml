@model BangLuong
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Thêm Bảng lương";
}

<div class="container-fluid p-4">
    <h2><i class="bi bi-plus-circle"></i> Thêm Bảng lương</h2>

    <div class="card mt-3">
        <div class="card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <strong>Có lỗi xảy ra:</strong>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="MaNV" class="form-label">Nhân viên <span class="text-danger">*</span></label>
                        <select asp-for="MaNV" class="form-select" required>
                            <option value="">-- Chọn nhân viên --</option>
                            @if (ViewBag.NhanViens != null)
                            {
                                @foreach (SelectListItem nv in ViewBag.NhanViens)
                                {
                                    <option value="@nv.Value">@nv.Text</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="MaNV" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Thang" class="form-label">Tháng <span class="text-danger">*</span></label>
                        <select asp-for="Thang" class="form-select" required>
                            @for (byte i = 1; i <= 12; i++)
                            {
                                <option value="@i">Tháng @i</option>
                            }
                        </select>
                        <span asp-validation-for="Thang" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Nam" class="form-label">Năm <span class="text-danger">*</span></label>
                        <select asp-for="Nam" class="form-select" required>
                            @for (short i = 2024; i <= 2030; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                        <span asp-validation-for="Nam" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="TongGioThucTe" class="form-label">Tổng giờ thực tế</label>
                        <input asp-for="TongGioThucTe" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="TongGioThucTe" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="TongLuongCa" class="form-label">Tổng lương ca</label>
                        <input asp-for="TongLuongCa" type="number" step="1" min="0" class="form-control" />
                        <span asp-validation-for="TongLuongCa" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="TongThuong" class="form-label">Tổng thưởng</label>
                        <input asp-for="TongThuong" type="number" step="1" min="0" class="form-control" />
                        <span asp-validation-for="TongThuong" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="TongKhauTru" class="form-label">Tổng khấu trừ</label>
                        <input asp-for="TongKhauTru" type="number" step="1" min="0" class="form-control" />
                        <span asp-validation-for="TongKhauTru" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="TrangThai" class="form-label">Trạng thái <span class="text-danger">*</span></label>
                        <select asp-for="TrangThai" class="form-select" required>
                            <option value="Tạm tính">Tạm tính</option>
                            <option value="Đã thanh toán">Đã thanh toán</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Thực lãnh</label>
                        <input type="text" class="form-control" value="(Tự động tính)" disabled />
                        <small class="text-muted">= Lương ca + Thưởng - Khấu trừ</small>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-coffee">
                        <i class="bi bi-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
