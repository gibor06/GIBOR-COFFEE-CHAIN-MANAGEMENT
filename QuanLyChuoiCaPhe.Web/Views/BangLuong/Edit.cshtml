@model BangLuong
@{
    ViewData["Title"] = "Sửa Bảng lương";
}

<div class="container-fluid p-4">
    <h2><i class="bi bi-pencil"></i> Sửa Bảng lương: @Model.ThongTinNhanVien?.HoTenNV - @Model.Thang/@Model.Nam</h2>

    <div class="card mt-3">
        <div class="card-body">
            <!-- Thông tin chỉ đọc -->
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Nhân viên</label>
                    <p>@Model.ThongTinNhanVien?.HoTenNV (@Model.MaNV)</p>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Tháng/Năm</label>
                    <p>@Model.Thang / @Model.Nam</p>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Thực lãnh (tự tính)</label>
                    <p class="text-success fw-bold fs-5">@(Model.ThucLanh?.ToString("N0") ?? "0") đ</p>
                </div>
            </div>

            <hr />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <strong>Có lỗi xảy ra:</strong>
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaNV" />
                <input type="hidden" asp-for="Thang" />
                <input type="hidden" asp-for="Nam" />

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="TongGioThucTe" class="form-label">Tổng giờ thực tế</label>
                        <input asp-for="TongGioThucTe" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="TongGioThucTe" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="TongLuongCa" class="form-label">Tổng lương ca</label>
                        <input asp-for="TongLuongCa" type="number" step="1" min="0" class="form-control" />
                        <span asp-validation-for="TongLuongCa" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="TongThuong" class="form-label">Tổng thưởng</label>
                        <input asp-for="TongThuong" type="number" step="1" min="0" class="form-control" />
                        <span asp-validation-for="TongThuong" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="TongKhauTru" class="form-label">Tổng khấu trừ</label>
                        <input asp-for="TongKhauTru" type="number" step="1" min="0" class="form-control" />
                        <span asp-validation-for="TongKhauTru" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="TrangThai" class="form-label">Trạng thái <span class="text-danger">*</span></label>
                        <select asp-for="TrangThai" class="form-select" required>
                            <option value="Tạm tính">Tạm tính</option>
                            <option value="Đã thanh toán">Đã thanh toán</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-coffee">
                        <i class="bi bi-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
